// Generated by tools/gen_aie_graph.py from aie/templates/sv_graph.h.in -- do not edit.
// SPLICE-V AIE graph: @N@ shared dispatcher worker(s) (@CLASSES@), each with one 64-bit
// input PLIO w<i>_in and one output PLIO w<i>_out.  The topology is static; the work of
// each tile is chosen at run time by the unit descriptors it receives (SPLICE-V sec. 3).
// Worker i's class (body mask) is listed in workers.json next to this file; the PS and the
// simulator data route units with reference/splicev_ref/routing.py using that list.
#ifndef SV_GRAPH_H
#define SV_GRAPH_H

#include <adf.h>
#include <string>

#include "sv_workers.h"

#define SV_N_WORKERS @N@
#ifndef SV_PLIO_MHZ
#define SV_PLIO_MHZ 0.0   // 0: the platform's PL clock for the PLIOs (aie pl-freq option)
#endif
#ifndef SV_STACK_BYTES
#define SV_STACK_BYTES @STACK@
#endif

class SvWorkersGraph : public adf::graph {
public:
    adf::kernel k[SV_N_WORKERS];
    adf::input_plio in[SV_N_WORKERS];
    adf::output_plio out[SV_N_WORKERS];

    SvWorkersGraph() {
@CREATE@
        for (int i = 0; i < SV_N_WORKERS; ++i) {
            const std::string id = std::to_string(i);
            adf::runtime<adf::ratio>(k[i]) = 0.9;
            adf::stack_size(k[i]) = SV_STACK_BYTES;
            in[i] = adf::input_plio::create("w" + id + "_in", adf::plio_64_bits, "data/w" + id + "_in.txt", SV_PLIO_MHZ);
            out[i] = adf::output_plio::create("w" + id + "_out", adf::plio_64_bits, "data/w" + id + "_out.txt", SV_PLIO_MHZ);
            adf::connect(in[i].out[0], k[i].in[0]);
            adf::connect(k[i].out[0], out[i].in[0]);
        }
    }
};

#endif
