  "tensors": [
    {
      "name": "hypothesis_head",
      "role": "anchor box hypotheses (mu, precision) used by the conformal gate",
      "shape": "per anchor: 4 means + 4 precisions",
      "consumer": "AIE GEMM/CONV -> PL sv_gate",
      "format": "int16 codes (formats from the export)"
    },
    {
      "name": "W_K",
      "role": "fragment key projection for the forecast logits",
      "shape": "[C, D_K]",
      "consumer": "AIE GEMM",
      "format": "int8 + shift"
    },
    {
      "name": "U",
      "role": "band-descriptor compatibility map (dot(U nu_f, U nu_g))",
      "shape": "[J, D_U]",
      "consumer": "AIE GEMM",
      "format": "int8 + shift"
    },
    {
      "name": "u0",
      "role": "null (abstention) logit vector",
      "shape": "[J]",
      "consumer": "AIE GEMM",
      "format": "int8"
    },
    {
      "name": "u_alpha",
      "role": "forecast shrink gate vector (alpha = (1 - 2^-4) sigmoid(u_alpha . nu))",
      "shape": "[J]",
      "consumer": "AIE GEMM",
      "format": "int8"
    },
    {
      "name": "O_F",
      "role": "value/output map of the forecast innovation",
      "shape": "[C, Ct]",
      "consumer": "AIE GEMM",
      "format": "int8 + shift"
    },
    {
      "name": "Z_l",
      "role": "per-level residual projection joining the class band only (Prop. 5)",
      "shape": "[Ct, C] per level",
      "consumer": "AIE GEMM (int16 x int8)",
      "format": "int8 + RZ shift"
    },
    {
      "name": "trust_heads",
      "role": "need, rho and Phi producers of the trust QP (Eq. (2)); Phi must be available before the solve",
      "shape": "[C] / [C] / [C, 4]",
      "consumer": "AIE GEMM -> PL sv_exchange1",
      "format": "Q8.23 after scaling"
    },
    {
      "name": "class_head",
      "role": "class-band readout weights",
      "shape": "[C, classes]",
      "consumer": "AIE GEMM + HEAD SCORE",
      "format": "int8 + shift"
    },
    {
      "name": "backbone_and_neck_layers",
      "role": "YOLO26 backbone/neck convolutions with their integer scales and requantization sites",
      "shape": "per layer",
      "consumer": "AIE CONV/GEMM units",
      "format": "int8 weights, int32 bias, per-channel shifts"
    }
  ],
